{
	"name": "mac-cleanup",
	"version": "0.1.0",
	"private": false,
	"license": "MIT",
	"description": "Conservative interactive cleanup utility for macOS developer tools",
	"type": "module",
	"bin": {
		"mac-cleanup": "dist/index.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"dev": "tsx src/index.ts",
		"build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
		"biome:fix": "biome check --fix --unsafe",
		"lint": "biome lint",
		"format:check": "biome format",
		"commitlint": "commitlint",
		"hooks:install": "lefthook install",
		"prepack": "npm run build",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@inquirer/prompts": "7.3.2",
		"commander": "13.1.0"
	},
	"devDependencies": {
		"@types/node": "24.13.3",
		"@biomejs/biome": "2.5.8",
		"@commitlint/cli": "20.5.0",
		"@commitlint/config-conventional": "20.5.0",
		"tsx": "4.19.3",
		"typescript": "5.8.3",
		"lefthook": "2.1.5"
	}
}
